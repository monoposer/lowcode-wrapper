# Declarative Foreign Server / Table config (file store mode)
# cp drivers.yaml.example drivers.yaml
#
# WRAPPER_STORE_MODE=file loads metadata from this file.
# WRAPPER_STORE_MODE=db uses Meta DB (GORM) + Admin API instead.
#
# On-disk shapes differ; after load the in-memory model matches db store:
#   file YAML: servers (inline credential) + tables + functions
#   db:        credentials + servers + foreign_tables + ...
#
# WRAPPER_DRIVERS_FILE=./drivers.yaml

servers:
  # Generic HTTP — credential inline on server, no top-level credentials block
  - name: partner_api
    protocol: http
    enabled: true
    credential:
      apiKey: ${PARTNER_API_KEY}
    options:
      endpoint: https://api.example.com
      basePath: /v1
      headers:
        X-Tenant: acme
      auth:
        type: API_KEY
        options:
          label: X-Api-Key

  - name: local_files
    protocol: file
    enabled: true
    options:
      rootPath: /tmp/wrapper-data

  # - name: airtable_ws
  #   protocol: airtable
  #   credential:
  #     token: ${AIRTABLE_TOKEN}
  #   options: {}
  # tables:
  #   - server: airtable_ws
  #     name: contacts
  #     remoteName: appXXXXX/Contacts

  # - name: gsheet
  #   protocol: sheets
  #   credential:
  #     accessToken: ${GOOGLE_ACCESS_TOKEN}
  #   options: {}
  # tables:
  #   - server: gsheet
  #     name: roster
  #     remoteName: spreadsheetId/Sheet1!A:Z

  - name: analytics_pg
    protocol: postgres
    credential:
      host: ${ANALYTICS_PG_HOST}
      port: ${ANALYTICS_PG_PORT}
      username: ${ANALYTICS_PG_USER}
      password: ${ANALYTICS_PG_PASSWORD}
      database: analytics
    options:
      schema: public

  # - name: notion_ws
  #   protocol: notion
  #   credential:
  #     token: ${NOTION_TOKEN}
  #   options:
  #     notionVersion: "2022-06-28"

tables:
  - server: partner_api
    schema: public
    name: orders
    remoteName: orders
    keyColumns: [id]
    options:
      headers:
        X-Table: orders
    columns:
      - name: id
        dataType: text
      - name: amount
        dataType: text
        remoteName: total_amount

  - server: local_files
    schema: public
    name: items
    remoteName: items.csv
    keyColumns: [id]
    options:
      format: csv
    columns:
      - name: id
        dataType: text
      - name: name
        dataType: text

  # - server: local_files
  #   schema: public
  #   name: catalog
  #   remoteName: catalog.yaml
  #   options:
  #     format: yaml

  # Multiple xlsx sheets: same remoteName, name equals sheet name
  # - server: local_files
  #   schema: public
  #   name: Q1
  #   remoteName: sales.xlsx
  #   options:
  #     format: xlsx
  # - server: local_files
  #   schema: public
  #   name: Q2
  #   remoteName: sales.xlsx
  #   options:
  #     format: xlsx
  # # GET /v1/public/Q1 → Q1 sheet in sales.xlsx

functions:
  - server: partner_api
    schema: public
    name: create_order
    operation: invoke
    remotePath: /orders/create
    method: POST

# When multiple servers share one credential, use top-level credentials + server.credential: name
# credentials:
#   - name: shared_partner
#     data:
#       apiKey: ${PARTNER_API_KEY}
# servers:
#   - name: api_a
#     protocol: http
#     credential: shared_partner
#   - name: api_b
#     protocol: http
#     credential: shared_partner
