# Meta store mode: where metadata is read from (db | file)
DATASPAN_STORE_MODE=db

# File mode: declarative YAML path or directory (all *.yaml / *.yml are merged)
# DATASPAN_DRIVERS_FILE=./drivers.yaml
# DATASPAN_DRIVERS_FILE=./drivers.d

# DB mode: Meta DB DSN (.env only, not in yaml). Supports postgres / mysql / sqlite.
DATABASE_URL=postgresql://dataspan:dataspan@localhost:5433/dataspan_meta?sslmode=disable
# DATABASE_DSN=mysql://user:pass@tcp(localhost:3306)/dataspan_meta
# DATABASE_DSN=file:./dataspan_meta.db

# Credential encryption key (32 bytes, base64). Server-only; not the data API apikey.
# Generate: openssl rand -base64 32
DATASPAN_VAULT_KEY=

PORT=3020

# Data API gateway (optional). When DATASPAN_ANON_KEY is set, /v1/ and /rest/v1/ require:
#   apikey: <anon or service key>
#   Authorization: Bearer <same key or HS256 JWT signed with DATASPAN_JWT_SECRET>
# Leave unset for open local dev (no RLS).
# DATASPAN_ANON_KEY=
# DATASPAN_SERVICE_KEY=
# DATASPAN_JWT_SECRET=

# Admin API (optional). When DATASPAN_ADMIN_KEY is set, /admin/api/* require:
#   X-Api-Key: <key>  OR  Authorization: Bearer <key>
# Leave unset for open local dev.
# DATASPAN_ADMIN_KEY=

# Meta DB schema migration on server startup (db mode). Default: enabled.
# Set to 0 in multi-replica production; run migrate once via CI or init Job.
# DATASPAN_AUTOMIGRATE=1

# Engine metadata resolve cache (optional). Example: 5s
# Invalidates when server/table/function metadata revision changes.
# DATASPAN_META_CACHE_TTL=5s

LOG_LEVEL=info
LOG_FORMAT=text

# Deploy compose image overrides (optional)
# DATASPAN_IMAGE=monoposer/dataspan:0.1.0
# DATASPAN_CLI_IMAGE=monoposer/dataspan-cli:0.1.0
