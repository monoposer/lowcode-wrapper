# Meta store mode: where metadata is read from (postgres | file)
WRAPPER_STORE_MODE=postgres

# File mode: declarative YAML path or directory (all *.yaml / *.yml are merged)
# WRAPPER_DRIVERS_FILE=./drivers.yaml
# WRAPPER_DRIVERS_FILE=./drivers.d

# Postgres mode: Meta DB connection (.env only, not in yaml)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=wrapper
DATABASE_PASSWORD=
DATABASE_NAME=wrapper_meta
DATABASE_SSLMODE=disable
# DATABASE_URL=postgresql://wrapper:wrapper@localhost:5433/wrapper_meta?sslmode=disable

# AES-256-GCM master key (32 bytes, base64). Generate: openssl rand -base64 32
WRAPPER_MASTER_KEY=

PORT=3020

LOG_LEVEL=info
LOG_FORMAT=text

# Deploy compose image overrides (optional)
# DATASPAN_IMAGE=monoposer/dataspan:0.1.0
# DATASPAN_CLI_IMAGE=monoposer/dataspan-cli:0.1.0
